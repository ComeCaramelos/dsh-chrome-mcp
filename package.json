{
  "name": "@comecaramelos/dsh-chrome-mcp",
  "description": "DSH plugin: DSH Chrome MCP bridge (`npx -y chrome-devtools-mcp@latest`) integration (wraps @deepseek-ai/dsh-mcp-client)",
  "author": "ComeCaramelos <hello@comecaramelos.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComeCaramelos/dsh-chrome-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ComeCaramelos/dsh-chrome-mcp/issues"
  },
  "homepage": "https://github.com/ComeCaramelos/dsh-chrome-mcp#readme",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:host": "tsc",
    "build:client": "tsc -p src/client/tsconfig.json && node scripts/build-client.mjs",
    "clean": "rm -rf lib",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.28",
    "typescript": "^5.9.3"
  }
}
